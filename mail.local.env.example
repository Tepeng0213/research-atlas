# Copy this file to mail.local.env and fill it in locally. Never commit or share it.
# Gmail: enable 2-Step Verification, then create an App Password (not your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=
MAIL_FROM=your-address@gmail.com
# During local development, open email links on the same computer running the workbench.
# For a deployment, set this to the actual HTTPS origin.
PUBLIC_BASE_URL=http://127.0.0.1:8765
